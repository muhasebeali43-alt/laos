import React, { useState, useEffect, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, collection, doc, onSnapshot, setDoc, addDoc, updateDoc, deleteDoc, query } from 'firebase/firestore';

// --- FİREBASE YAPILANDIRMASI ---
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'cafe-pro-v1';

// --- YARDIMCI ARAÇLAR ---
const toNum = (v) => {
  if (v === null || v === undefined || v === "") return 0;
  if (typeof v === 'number') return v;
  // Binlik ayracı olan noktayı ve varsa virgülü temizler
  const clean = String(v).replace(/\./g, '').replace(/,/g, '');
  return parseInt(clean, 10) || 0;
};

const formatNumber = (val) => new Intl.NumberFormat('tr-TR').format(toNum(val));
const formatCurrency = (val) => new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', minimumFractionDigits: 0 }).format(toNum(val));

const dbToDisplay = (isoDate) => {
  if (!isoDate) return "";
  const parts = isoDate.split("-");
  return parts.length === 3 ? `${parts[2]}.${parts[1]}.${parts[0]}` : isoDate;
};

const displayToDb = (displayDate) => {
  if (!displayDate) return null;
  const parts = displayDate.split(".");
  return parts.length === 3 ? `${parts[2]}-${parts[1]}-${parts[0]}` : null;
};

const ALL_PAYMENT_METHODS = [
  { id: 'nakit', label: 'Nakit', color: 'bg-emerald-100 text-emerald-700' },
  { id: 'havale', label: 'Havale', color: 'bg-blue-100 text-blue-700' },
  { id: 'cek', label: 'Çek', color: 'bg-purple-100 text-purple-700' },
  { id: 'kart', label: 'Kart', color: 'bg-amber-100 text-amber-700' }
];

// --- BİLEŞENLER ---

const MoneyInput = ({ value, onChange, className = "", placeholder = "0" }) => {
  const [display, setDisplay] = useState(formatNumber(value));
  useEffect(() => { setDisplay(formatNumber(value)); }, [value]);
  const handleChange = (e) => {
    const raw = e.target.value.replace(/[^0-9]/g, '');
    const numValue = raw ? parseInt(raw, 10) : 0;
    setDisplay(formatNumber(numValue));
    onChange(numValue);
  };
  return <input type="text" inputMode="numeric" value={display === "0" && placeholder !== "0" ? "" : display} onChange={handleChange} placeholder={placeholder} className={className} />;
};

const DateInput = ({ value, onChange, className = "" }) => {
  const [localVal, setLocalVal] = useState(dbToDisplay(value));
  useEffect(() => { setLocalVal(dbToDisplay(value)); }, [value]);
  const handleChange = (e) => {
    let v = e.target.value.replace(/[^0-9]/g, '').substring(0, 8);
    let formatted = v;
    if (v.length > 2) formatted = v.substring(0, 2) + '.' + v.substring(2);
    if (v.length > 4) formatted = formatted.substring(0, 5) + '.' + formatted.substring(5);
    setLocalVal(formatted);
    if (v.length === 8) {
      const dbVal = displayToDb(formatted);
      if (dbVal) onChange(dbVal);
    }
  };
  return (
    <div className="flex items-center gap-1 relative">
      <input type="date" value={value || ""} onChange={(e) => e.target.value && onChange(e.target.value)} className="absolute inset-0 opacity-0 cursor-pointer w-full h-full" />
      <span className="text-amber-500 text-[10px]">📅</span>
      <input type="text" value={localVal} onChange={handleChange} maxLength={10} placeholder="GG.AA.YYYY" className={`bg-transparent border-none focus:ring-0 p-0 text-[10px] font-bold w-18 ${className}`} />
    </div>
  );
};

const MethodSelector = ({ value, onChange, className = "" }) => (
  <select value={value || 'nakit'} onChange={(e) => onChange(e.target.value)} className={`bg-slate-50 border border-slate-200 rounded px-2 py-1 text-[9px] font-bold uppercase text-slate-700 focus:ring-1 focus:ring-amber-500 cursor-pointer ${className}`}>
    {ALL_PAYMENT_METHODS.map(m => <option key={m.id} value={m.id}>{m.label}</option>)}
  </select>
);

const MethodBadge = ({ method }) => {
  const m = ALL_PAYMENT_METHODS.find(x => x.id === method) || ALL_PAYMENT_METHODS[0];
  return <span className={`flex items-center gap-1 px-1.5 py-0.5 rounded text-[7px] font-bold uppercase ${m.color}`}>{m.label}</span>;
};

// --- ANA UYGULAMA ---

export default function App() {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('dashboard');
  const [loading, setLoading] = useState(true);
  const [reportRange, setReportRange] = useState('monthly');
  const [customStartDate, setCustomStartDate] = useState(new Date().toISOString().split('T')[0]);
  const [customEndDate, setCustomEndDate] = useState(new Date().toISOString().split('T')[0]);
  const [selectedPersonnelId, setSelectedPersonnelId] = useState(null);
  const [showDeleteModal, setShowDeleteModal] = useState({ show: false, col: '', id: '' });

  const [settings, setSettings] = useState({ initialBalance: 0, defaultCommission: 3.5, defaultValor: 30 });
  const [dailyLogs, setDailyLogs] = useState([]);
  const [scheduledPayments, setScheduledPayments] = useState([]);
  const [personnel, setPersonnel] = useState([]);
  const [personnelPayments, setPersonnelPayments] = useState([]);

  // Kimlik Doğrulama ve Senkronizasyon (Kural 1, 2, 3)
  useEffect(() => {
    const initAuth = async () => {
      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        await signInWithCustomToken(auth, __initial_auth_token);
      } else {
        await signInAnonymously(auth);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  useEffect(() => {
    if (!user) return;

    const publicCol = (name) => collection(db, 'artifacts', appId, 'public', 'data', name);

    const unsubSettings = onSnapshot(doc(db, 'artifacts', appId, 'public', 'data', 'config', 'app_settings'), (d) => d.exists() && setSettings(d.data()));
    const unsubLogs = onSnapshot(query(publicCol('dailyLogs')), (s) => setDailyLogs(s.docs.map(d => ({id: d.id, ...d.data()}))));
    const unsubSched = onSnapshot(query(publicCol('scheduledPayments')), (s) => setScheduledPayments(s.docs.map(d => ({id: d.id, ...d.data()}))));
    const unsubPers = onSnapshot(query(publicCol('personnel')), (s) => setPersonnel(s.docs.map(d => ({id: d.id, ...d.data()}))));
    const unsubPersPay = onSnapshot(query(publicCol('personnelPayments')), (s) => setPersonnelPayments(s.docs.map(d => ({id: d.id, ...d.data()}))));

    setLoading(false);
    return () => { unsubSettings(); unsubLogs(); unsubSched(); unsubPers(); unsubPersPay(); };
  }, [user]);

  // Canlı Hesaplama Mantığı (Veri silindiğinde otomatik güncellenir)
  const stats = useMemo(() => {
    const logsTotals = dailyLogs.reduce((acc, log) => {
      const cash = toNum(log.cash);
      const card = toNum(log.card);
      const loan = toNum(log.dailyLoan);
      const comm = (card * toNum(settings.defaultCommission || 3.5)) / 100;
      return { loan: acc.loan + loan, cash: acc.cash + cash, card: acc.card + card, comm: acc.comm + comm };
    }, { loan: 0, cash: 0, card: 0, comm: 0 });

    const billsPaid = scheduledPayments.filter(p => p.status === 'paid').reduce((s, p) => s + toNum(p.amount), 0);
    const staffPaid = personnelPayments.reduce((s, p) => s + toNum(p.amount), 0);
    
    // NAKİT GÜCÜ: Gerçek girenler - Gerçek çıkanlar
    const netCash = toNum(settings.initialBalance) + logsTotals.cash + logsTotals.card + logsTotals.loan - (staffPaid + billsPaid + logsTotals.comm);
    const posPending = logsTotals.card - logsTotals.comm;
    
    const upcoming = scheduledPayments
      .filter(p => p.status !== 'paid')
      .sort((a, b) => new Date(a.date) - new Date(b.date))
      .slice(0, 4);

    return { ...logsTotals, billsPaid, staffPaid, netCash, posPending, upcoming };
  }, [dailyLogs, scheduledPayments, personnelPayments, settings]);

  const reportAnalysis = useMemo(() => {
    const now = new Date();
    const start = new Date(customStartDate);
    const end = new Date(customEndDate);
    start.setHours(0,0,0,0); end.setHours(23,59,59,999);

    const filterFn = (dStr) => {
      if (!dStr) return false;
      const d = new Date(dStr);
      if (reportRange === 'daily') return d.toDateString() === now.toDateString();
      if (reportRange === 'monthly') return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
      if (reportRange === 'custom') return d >= start && d <= end;
      return true;
    };

    const fLogs = dailyLogs.filter(l => filterFn(l.date));
    const fPersPays = personnelPayments.filter(p => filterFn(p.date));
    const fSchedPays = scheduledPayments.filter(p => p.status === 'paid' && filterFn(p.date));

    const incomeSum = fLogs.reduce((a, l) => ({ cash: a.cash + toNum(l.cash), card: a.card + toNum(l.card), loan: a.loan + toNum(l.dailyLoan) }), {cash:0, card:0, loan:0});
    const totalIn = incomeSum.cash + incomeSum.card + incomeSum.loan;
    
    const staffEx = fPersPays.reduce((s, p) => s + toNum(p.amount), 0);
    const posEx = fLogs.reduce((s, l) => s + (toNum(l.card) * toNum(settings.defaultCommission || 3.5) / 100), 0);
    const malEx = fSchedPays.filter(p => { const l = (p.label || "").toLowerCase(); return l.includes('mal') || l.includes('ürün') || l.includes('gıda'); }).reduce((s, p) => s + toNum(p.amount), 0);
    const totalEx = staffEx + posEx + malEx + (fSchedPays.reduce((s, p) => s + toNum(p.amount), 0) - malEx);
    
    return { totalIn, totalEx, profit: totalIn - totalEx, margin: totalIn > 0 ? ((totalIn - totalEx) / totalIn) * 100 : 0, staffEx, posEx, malEx };
  }, [dailyLogs, personnelPayments, scheduledPayments, reportRange, customStartDate, customEndDate, settings]);

  const posSettlements = useMemo(() => {
    const today = new Date(); today.setHours(0,0,0,0);
    const valor = toNum(settings.defaultValor || 30);
    return dailyLogs.filter(log => toNum(log.card) > 0).map(log => {
      const dateObj = new Date(log.date);
      if (isNaN(dateObj)) return null;
      const settleDate = new Date(dateObj);
      settleDate.setDate(dateObj.getDate() + valor);
      const net = toNum(log.card) - (toNum(log.card) * toNum(settings.defaultCommission) / 100);
      return { id: log.id, date: log.date, settle: settleDate, net, settled: settleDate <= today };
    }).filter(x => x !== null).sort((a,b) => a.settle - b.settle);
  }, [dailyLogs, settings]);

  // --- AKSİYONLAR ---
  const publicRef = (col, id = null) => id ? doc(db, 'artifacts', appId, 'public', 'data', col, id) : collection(db, 'artifacts', appId, 'public', 'data', col);

  const confirmDelete = async () => {
    if (!user) return;
    const { col, id } = showDeleteModal;
    await deleteDoc(publicRef(col, id));
    setShowDeleteModal({ show: false, col: '', id: '' });
  };

  const saveSettings = async (newVal) => {
    if (!user) return;
    await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'config', 'app_settings'), newVal, { merge: true });
  };

  if (loading) return <div className="h-screen bg-slate-950 flex items-center justify-center text-amber-500 font-black animate-pulse uppercase text-[10px] tracking-widest">Laos Finans Hazırlanıyor...</div>;

  return (
    <div className="min-h-screen flex flex-col md:flex-row pb-20 md:pb-0 bg-[#F8FAFC] font-sans">
      
      {/* SİLME ONAY MODALI */}
      {showDeleteModal.show && (
        <div className="fixed inset-0 flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-sm z-[2000]">
          <div className="bg-white rounded-2xl p-6 max-w-xs w-full shadow-2xl animate-up text-center">
            <div className="w-12 h-12 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-xl">🗑️</div>
            <h3 className="text-xs font-black text-slate-900 mb-6 uppercase">Veri silinsin mi?</h3>
            <div className="flex gap-3">
              <button onClick={() => setShowDeleteModal({show:false, col:'', id:''})} className="flex-1 py-3 rounded-xl bg-slate-100 text-slate-500 font-bold text-[9px] uppercase">Vazgeç</button>
              <button onClick={confirmDelete} className="flex-1 py-3 rounded-xl bg-red-500 text-white font-bold text-[9px] uppercase shadow-lg shadow-red-200">Onayla</button>
            </div>
          </div>
        </div>
      )}

      {/* NAVİGASYON */}
      <nav className="fixed bottom-0 left-0 right-0 md:relative md:w-20 lg:w-64 bg-slate-950 text-white p-1.5 md:p-4 flex md:flex-col justify-around md:justify-start gap-1 z-50">
        <div className="hidden md:flex items-center gap-3 mb-10 px-2">
          <div className="w-8 h-8 bg-amber-500 rounded-lg flex items-center justify-center text-slate-950 font-black italic shadow-lg text-[10px]">L</div>
          <h2 className="hidden lg:block font-black text-sm italic uppercase laos-gradient-text tracking-tighter">Kafe Analiz</h2>
        </div>
        {[
          {id:'dashboard', icon:'📊', l:'Özet'},
          {id:'daily', icon:'📅', l:'Günlük'},
          {id:'pos', icon:'💳', l:'POS'},
          {id:'personnel', icon:'👥', l:'Ekip'},
          {id:'payments', icon:'🧾', l:'Ödemeler'},
          {id:'reports', icon:'📈', l:'Analiz'}
        ].map(t => (
          <button key={t.id} onClick={() => {setActiveTab(t.id); setSelectedPersonnelId(null);}} 
            className={`flex flex-col md:flex-row items-center gap-1 md:gap-3 p-2 rounded-xl transition-all flex-1 md:flex-none ${activeTab === t.id ? 'bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/20' : 'text-slate-500 hover:text-slate-200'}`}>
            <span className="text-base">{t.icon}</span> 
            <span className="text-[7px] lg:text-[11px] font-black uppercase tracking-tight text-center lg:text-left">{t.l}</span>
          </button>
        ))}
      </nav>

      {/* İÇERİK ALANI */}
      <main className="flex-1 p-3 md:p-8 lg:p-12 overflow-y-auto max-w-full">
        
        {/* ÖZET PANELİ */}
        {activeTab === 'dashboard' && (
          <div className="max-w-4xl mx-auto space-y-6 animate-up">
            <header className="flex items-center gap-2"><div className="w-1 h-6 bg-amber-500 rounded-full"></div><h1 className="text-lg md:text-2xl font-black text-slate-900 uppercase italic">İşletme Özeti</h1></header>
            
            <div className="bg-slate-950 rounded-3xl p-6 md:p-10 text-white shadow-2xl border-b-[6px] border-amber-500 relative overflow-hidden">
              <div className="relative z-10">
                <p className="text-[9px] md:text-[11px] font-bold text-slate-500 uppercase mb-2 tracking-[0.3em]">💰 Mevcut Nakit Gücü</p>
                <h2 className="text-2xl md:text-5xl font-black text-amber-500 tracking-tighter mb-8 italic break-words">{formatCurrency(stats.netCash)}</h2>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 border-t border-white/5 pt-6">
                  <div><p className="text-[8px] text-slate-500 font-bold uppercase mb-0.5 italic">Ciro</p><p className="font-bold text-[10px] md:text-lg text-slate-100">{formatCurrency(stats.cash + stats.card)}</p></div>
                  <div><p className="text-[8px] text-slate-500 font-bold uppercase mb-0.5 italic">Gider</p><p className="font-bold text-[10px] md:text-lg text-red-400">{formatCurrency(stats.staffPaid + stats.billsPaid + stats.comm)}</p></div>
                  <div><p className="text-[8px] text-slate-500 font-bold uppercase mb-0.5 italic">Kredi</p><p className="font-bold text-[10px] md:text-lg text-blue-400">{formatCurrency(stats.loan)}</p></div>
                  <div><p className="text-[8px] text-slate-500 font-bold uppercase mb-0.5 italic">Bakiye</p><p className="font-bold text-[10px] md:text-lg text-slate-400">{formatCurrency(settings.initialBalance)}</p></div>
                </div>
              </div>
            </div>

            <div className="white-card p-5 border-l-4 border-red-500 shadow-sm space-y-4">
              <h3 className="text-xs md:text-base font-black text-slate-800 uppercase italic flex items-center gap-2">🔔 Bekleyen Ödemeler</h3>
              <div className="space-y-2">
                {stats.upcoming.length > 0 ? stats.upcoming.map(p => (
                  <div key={p.id} className="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100">
                    <div className="flex items-center gap-2">
                      <div className="text-[8px] font-black text-red-600">{dbToDisplay(p.date)}</div>
                      <div className="font-black text-[9px] md:text-sm uppercase">{p.label}</div>
                    </div>
                    <p className="text-[10px] md:text-sm font-black text-red-600">{formatCurrency(p.amount)}</p>
                  </div>
                )) : <p className="text-center py-2 text-[8px] text-slate-300 font-bold uppercase italic">Planlı Ödeme Kaydı Yok</p>}
              </div>
            </div>

            <div className="bg-slate-950 p-5 rounded-2xl shadow-xl border border-slate-800">
              <p className="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-1 italic">Sistem Kasa Başlangıcı</p>
              <MoneyInput value={settings.initialBalance} onChange={(val) => saveSettings({ initialBalance: val })} className="text-xl md:text-3xl font-black bg-transparent w-full focus:ring-0 text-amber-500 italic" />
            </div>
          </div>
        )}

        {/* GÜNLÜK GİRİŞ */}
        {activeTab === 'daily' && (
          <div className="max-w-2xl mx-auto space-y-3 animate-up">
            <div className="flex justify-between items-center mb-6 bg-slate-950 p-4 rounded-2xl border-b-4 border-amber-500">
              <h2 className="text-white font-black text-[10px] md:text-sm uppercase italic tracking-widest">Günlük Hasılat</h2>
              <button onClick={() => addDoc(publicRef('dailyLogs'), { date: new Date().toISOString().split('T')[0], cash: 0, card: 0, dailyLoan: 0 })} className="bg-amber-500 text-slate-950 px-4 py-2 rounded-xl font-black text-[8px] uppercase italic active:scale-95 transition-all">YENİ GÜN</button>
            </div>
            {dailyLogs.sort((a,b) => new Date(b.date) - new Date(a.date)).map(log => (
              <div key={log.id} className="bg-white rounded-2xl p-4 border border-slate-100 shadow-sm space-y-4">
                <div className="flex justify-between items-center border-b border-slate-50 pb-2">
                  <div className="bg-slate-950 px-2 py-1 rounded-lg text-amber-500 shadow-sm"><DateInput value={log.date} onChange={(d) => updateDoc(publicRef('dailyLogs', log.id), { date: d })} /></div>
                  <button onClick={() => setShowDeleteModal({show:true, col:'dailyLogs', id:log.id})} className="text-red-200 hover:text-red-500">🗑️</button>
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div className="bg-slate-50 p-2.5 rounded-xl">
                    <p className="text-[7px] font-black text-slate-400 mb-0.5 uppercase italic">Nakit</p>
                    <MoneyInput value={log.cash} onChange={(v) => updateDoc(publicRef('dailyLogs', log.id), { cash: v })} className="w-full bg-transparent font-black text-sm border-none p-0 focus:ring-0" />
                  </div>
                  <div className="bg-blue-50 p-2.5 rounded-xl">
                    <p className="text-[7px] font-black text-blue-500 mb-0.5 uppercase italic">POS</p>
                    <MoneyInput value={log.card} onChange={(v) => updateDoc(publicRef('dailyLogs', log.id), { card: v })} className="w-full bg-transparent font-black text-sm text-blue-700 border-none p-0 focus:ring-0" />
                  </div>
                </div>
                <div className="bg-slate-950 p-2.5 rounded-xl border border-slate-900 text-center">
                  <p className="text-[7px] font-black text-amber-500 uppercase italic">Kredi / Borç Girişi</p>
                  <MoneyInput value={log.dailyLoan || 0} onChange={(v) => updateDoc(publicRef('dailyLogs', log.id), { dailyLoan: v })} className="w-full bg-transparent p-0 border-none font-black text-lg text-white italic text-center focus:ring-0" />
                </div>
              </div>
            ))}
          </div>
        )}

        {/* POS TAKİBİ */}
        {activeTab === 'pos' && (
          <div className="max-w-4xl mx-auto space-y-4 animate-up">
            <header className="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-3 bg-slate-950 p-4 rounded-2xl border-b-4 border-amber-500">
              <h2 className="text-white font-black text-[10px] md:text-sm uppercase italic tracking-widest">Banka / POS Bekleyen</h2>
              <div className="bg-white/5 border border-white/10 px-4 py-2 rounded-xl text-center w-full md:w-auto">
                <p className="text-[7px] font-bold text-slate-500 uppercase italic">Net Alacak</p>
                <p className="text-sm md:text-xl font-black text-amber-500 tracking-tight">{formatCurrency(stats.posPending)}</p>
              </div>
            </header>
            <div className="grid grid-cols-2 gap-3">
              <div className="white-card p-4 border-l-4 border-amber-500">
                <p className="text-[7px] font-black text-slate-400 uppercase italic mb-1">Komisyon (%)</p>
                <input type="number" step="0.1" value={settings.defaultCommission} onChange={(e) => saveSettings({ defaultCommission: Number(e.target.value) })} className="text-sm md:text-xl font-black bg-transparent w-full focus:ring-0 text-slate-800" />
              </div>
              <div className="white-card p-4 border-l-4 border-slate-900">
                <p className="text-[7px] font-black text-slate-400 uppercase italic mb-1">Vade (Gün)</p>
                <input type="number" value={settings.defaultValor} onChange={(e) => saveSettings({ defaultValor: Number(e.target.value) })} className="text-sm md:text-xl font-black bg-transparent w-full focus:ring-0 text-slate-800" />
              </div>
            </div>
            <div className="space-y-2 mt-6">
              {posSettlements.length > 0 ? posSettlements.map(p => (
                <div key={p.id} className={`bg-white p-3 rounded-xl flex justify-between items-center transition-all ${p.settled ? 'opacity-30' : 'border border-amber-50 shadow-sm'}`}>
                  <div className="flex items-center gap-3">
                    <div className="bg-slate-950 p-2 rounded-lg text-amber-500 shadow-sm">🏦</div>
                    <div>
                      <p className="text-[7px] font-black text-slate-400 uppercase italic">İşlem: {dbToDisplay(p.date)}</p>
                      <p className="text-[9px] font-bold text-slate-800 uppercase italic">Tahmini: {p.settle.toLocaleDateString('tr-TR')}</p>
                    </div>
                  </div>
                  <div className="text-right">
                    <p className="text-[10px] md:text-sm font-black text-slate-950">{formatCurrency(p.net)}</p>
                    {p.settled && <span className="text-[6px] font-black text-green-500 uppercase italic">Kayıtlı</span>}
                  </div>
                </div>
              )) : <p className="text-center py-10 text-[8px] text-slate-300 font-bold uppercase italic">POS İşlem Kaydı Bulunmuyor</p>}
            </div>
          </div>
        )}

        {/* EKİP YÖNETİMİ */}
        {activeTab === 'personnel' && (
          <div className="max-w-6xl mx-auto space-y-4">
            {!selectedPersonnelId ? (
              <div className="animate-up">
                <div className="flex justify-between items-center mb-6 bg-slate-950 p-4 rounded-2xl border-b-4 border-amber-500">
                  <h2 className="text-white font-black text-[10px] md:text-sm uppercase italic">Ekip</h2>
                  <button onClick={() => addDoc(publicRef('personnel'), { name: 'Yeni Personel', type: 'Tam Zamanlı', fixedSalary: 50000 })} className="bg-amber-500 text-slate-950 px-4 py-2 rounded-xl font-black text-[8px] uppercase italic transition-transform active:scale-95">PERSONEL EKLE</button>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                  {personnel.map(p => {
                    const paid = personnelPayments.filter(pay => pay.personnelId === p.id).reduce((s, pay) => s + toNum(pay.amount), 0);
                    const bal = toNum(p.fixedSalary) - paid;
                    return (
                      <div key={p.id} onClick={() => setSelectedPersonnelId(p.id)} className="bg-white p-4 rounded-2xl flex flex-col justify-between cursor-pointer border border-transparent hover:border-amber-400 transition-all shadow-sm min-h-[100px]">
                        <div className="flex justify-between items-start mb-2">
                          <div className="bg-slate-950 p-2 rounded-lg text-amber-500">👤</div>
                          <button onClick={(e) => { e.stopPropagation(); setShowDeleteModal({show:true, col:'personnel', id:p.id}); }} className="text-red-200 hover:text-red-500">SİL</button>
                        </div>
                        <div>
                          <p className="font-black text-xs uppercase text-slate-800 leading-tight">{p.name}</p>
                          <p className={`text-[8px] font-black uppercase italic ${bal > 0 ? 'text-red-500' : 'text-green-500'}`}>Borç Kalan: {formatCurrency(bal)}</p>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            ) : (
              <div className="space-y-4 animate-up">
                <button onClick={() => setSelectedPersonnelId(null)} className="font-black text-[8px] uppercase text-slate-400 bg-white px-3 py-1.5 rounded-lg border border-slate-100 flex items-center gap-1.5 hover:text-slate-900 transition-all italic tracking-widest">🔙 Geri Dön</button>
                {personnel.filter(p => p.id === selectedPersonnelId).map(p => {
                  const myPays = personnelPayments.filter(pay => pay.personnelId === p.id).sort((a,b) => new Date(b.date) - new Date(a.date));
                  const totalPaid = myPays.reduce((s, pay) => s + toNum(pay.amount), 0);
                  const totalSalary = toNum(p.fixedSalary);
                  return (
                    <div key={p.id} className="space-y-4">
                      <div className="bg-slate-950 p-6 rounded-3xl text-white shadow-xl border-b-4 border-amber-500">
                        <input value={p.name} onChange={(e) => updateDoc(publicRef('personnel', p.id), { name: e.target.value })} className="text-lg md:text-3xl font-black bg-transparent w-full uppercase text-amber-500 italic mb-4 focus:ring-0 border-none p-0" />
                        <div className="grid grid-cols-2 gap-3">
                          <div className="bg-white/5 p-3 rounded-xl border border-white/5">
                            <p className="text-[7px] font-bold text-slate-500 uppercase mb-1 italic">SABİT MAAŞ</p>
                            <div className="flex items-center gap-1 font-black text-xs md:text-xl text-amber-500 italic">
                                <MoneyInput value={p.fixedSalary} onChange={(val) => updateDoc(publicRef('personnel', p.id), { fixedSalary: val })} className="bg-transparent w-full border-none focus:ring-0" />
                            </div>
                          </div>
                          <div className="bg-white/5 p-3 rounded-xl border border-white/5">
                            <p className="text-[7px] font-bold text-slate-500 uppercase mb-1 italic">BORÇ KALAN</p>
                            <p className={`text-xs md:text-xl font-black italic ${totalSalary - totalPaid > 0 ? 'text-red-400' : 'text-green-400'}`}>{formatCurrency(totalSalary - totalPaid)}</p>
                          </div>
                        </div>
                      </div>
                      
                      <div className="bg-white rounded-2xl p-4 shadow-md space-y-3">
                        <div className="flex justify-between items-center border-b border-slate-50 pb-2 mb-2">
                          <h3 className="text-[9px] font-black uppercase italic text-slate-800">Ödemeler</h3>
                          <button onClick={() => addDoc(publicRef('personnelPayments'), { personnelId: p.id, amount: 0, method: 'nakit', date: new Date().toISOString().split('T')[0] })} className="bg-slate-950 text-white px-3 py-1.5 rounded-lg text-[8px] font-black uppercase active:scale-95 italic transition-all">YENİ ÖDEME</button>
                        </div>
                        {myPays.map(pay => (
                          <div key={pay.id} className="flex items-center justify-between gap-2 p-2 bg-slate-50 rounded-lg border border-slate-100 transition-all">
                            <DateInput value={pay.date} onChange={(newDate) => updateDoc(publicRef('personnelPayments', pay.id), { date: newDate })} className="text-slate-400 text-[9px]" />
                            <MethodSelector value={pay.method} onChange={(newMethod) => updateDoc(publicRef('personnelPayments', pay.id), { method: newMethod })} className="w-18 md:w-32" />
                            <div className="flex items-center gap-1"><span className="font-black text-slate-300 text-[9px]">₺</span><MoneyInput value={pay.amount} onChange={(val) => updateDoc(publicRef('personnelPayments', pay.id), { amount: val })} className="bg-transparent w-14 md:w-20 font-black text-[10px] md:text-xs text-right border-none focus:ring-0" /></div>
                            <button onClick={() => setShowDeleteModal({show:true, col:'personnelPayments', id:pay.id})} className="text-red-200 hover:text-red-500">🗑️</button>
                          </div>
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        )}

        {/* ÖDEME PLANI */}
        {activeTab === 'payments' && (
          <div className="max-w-2xl mx-auto space-y-3 animate-up">
            <div className="flex justify-between items-center mb-6 bg-slate-950 p-4 rounded-2xl border-b-4 border-amber-500 shadow-xl">
              <h2 className="text-white font-black text-[10px] md:text-sm uppercase italic">Ödeme Planı</h2>
              <button onClick={() => addDoc(publicRef('scheduledPayments'), { label: 'Yeni Kalem', amount: 0, status: 'pending', method: 'nakit', date: new Date().toISOString().split('T')[0] })} className="bg-amber-500 text-slate-950 px-4 py-2 rounded-xl font-black text-[8px] uppercase italic transition-all active:scale-95">EKLE</button>
            </div>
            {scheduledPayments.sort((a,b) => new Date(b.date) - new Date(a.date)).map(p => (
              <div key={p.id} className={`bg-white rounded-2xl p-4 flex flex-col md:flex-row justify-between items-center gap-3 transition-all ${p.status === 'paid' ? 'opacity-40 grayscale-[0.6]' : 'shadow-sm border-l-4 border-red-500'}`}>
                <div className="flex-1 w-full space-y-2">
                  <div className="flex flex-wrap items-center gap-2">
                    <div className="bg-slate-50 p-1 rounded border border-slate-100 shadow-inner"><DateInput value={p.date} onChange={(d) => updateDoc(publicRef('scheduledPayments', p.id), { date: d })} className="text-red-500 font-bold" /></div>
                    <MethodSelector value={p.method} onChange={(m) => updateDoc(publicRef('scheduledPayments', p.id), { method: m })} className="w-20 md:w-28" />
                  </div>
                  <input value={p.label} onChange={(e) => updateDoc(publicRef('scheduledPayments', p.id), { label: e.target.value })} className="font-black text-xs md:text-lg w-full uppercase border-none p-0 focus:ring-0 italic text-slate-800" placeholder="Gider Adı" />
                  <div className="flex items-center gap-1 font-black text-sm md:text-xl text-slate-950 italic"><span className="text-[10px] md:text-sm text-slate-300">₺</span><MoneyInput value={p.amount} onChange={(v) => updateDoc(publicRef('scheduledPayments', p.id), { amount: v })} className="bg-transparent w-full border-none p-0 focus:ring-0" /></div>
                </div>
                <div className="flex gap-2 w-full md:w-auto border-t md:border-none pt-2 md:pt-0">
                  <button onClick={() => updateDoc(publicRef('scheduledPayments', p.id), { status: p.status === 'paid' ? 'pending' : 'paid' })} className={`flex-1 px-4 py-2 rounded-lg font-black text-[8px] uppercase transition-all shadow-md italic ${p.status === 'paid' ? 'bg-green-500 text-white' : 'bg-slate-900 text-white active:scale-95'}`}>{p.status === 'paid' ? 'Ödendi' : 'Ödemeyi Yap'}</button>
                  <button onClick={() => setShowDeleteModal({show:true, col:'scheduledPayments', id:p.id})} className="text-red-200 p-1">🗑️</button>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* ANALİZ */}
        {activeTab === 'reports' && (
          <div className="max-w-4xl mx-auto space-y-6 animate-up pb-10">
            <header className="flex flex-col md:flex-row justify-between items-center gap-3">
              <div className="flex items-center gap-2"><div className="w-1 h-6 bg-amber-500 rounded-full"></div><h2 className="text-lg md:text-2xl font-black text-slate-900 uppercase italic">Stratejik Analiz</h2></div>
              <div className="flex bg-slate-900 p-0.5 rounded-lg md:rounded-full border border-slate-800 shadow-xl overflow-x-auto no-scrollbar max-w-full">
                {['daily', 'monthly', 'custom'].map(r => (
                  <button key={r} onClick={() => setReportRange(r)} className={`px-4 py-1.5 md:px-8 md:py-2.5 rounded-md md:rounded-full text-[8px] md:text-[9px] font-black uppercase tracking-tight transition-all ${reportRange === r ? 'bg-amber-500 text-slate-950 shadow-md' : 'text-slate-500 hover:text-slate-200'}`}>
                    {r === 'daily' ? 'BUGÜN' : r === 'monthly' ? 'BU AY' : 'ÖZEL'}
                  </button>
                ))}
              </div>
            </header>

            <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
              <div className="bg-white p-3 rounded-xl border-l-4 border-emerald-500 shadow-sm flex flex-col justify-between">
                <p className="text-[7px] font-black text-slate-400 uppercase italic">Hasılat</p>
                <p className="text-[10px] md:text-lg font-black text-slate-900 tracking-tighter">{formatCurrency(reportAnalysis.totalIn)}</p>
              </div>
              <div className="bg-white p-3 rounded-xl border-l-4 border-red-500 shadow-sm flex flex-col justify-between">
                <p className="text-[7px] font-black text-slate-400 uppercase italic">Gider</p>
                <p className="text-[10px] md:text-lg font-black text-red-600 tracking-tighter">{formatCurrency(reportAnalysis.totalEx)}</p>
              </div>
              <div className="bg-slate-900 p-3 rounded-xl text-white shadow-lg flex flex-col justify-center border-b-2 border-amber-500">
                <p className="text-[7px] font-black text-slate-500 uppercase italic">Net Kâr</p>
                <p className={`text-[10px] md:text-lg font-black tracking-tighter ${reportAnalysis.profit >= 0 ? 'text-amber-500' : 'text-red-400'}`}>{formatCurrency(reportAnalysis.profit)}</p>
              </div>
              <div className="bg-white p-3 rounded-xl border-l-4 border-blue-500 shadow-sm flex flex-col justify-center">
                <p className="text-[7px] font-black text-slate-400 uppercase italic">Kâr Marjı</p>
                <p className="text-[10px] md:text-lg font-black text-blue-600 tracking-tighter">%{reportAnalysis.margin.toFixed(0)}</p>
              </div>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div className="bg-white rounded-3xl p-6 shadow-sm space-y-6">
                <h3 className="text-xs font-black text-slate-800 uppercase italic border-b border-slate-50 pb-3">Gider Yapısı</h3>
                <div className="space-y-4">
                  {[
                    { l: 'Maaş', val: reportAnalysis.staffEx, r: (reportAnalysis.staffEx / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-amber-500' },
                    { l: 'Mal / Stok', val: reportAnalysis.malEx, r: (reportAnalysis.malEx / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-emerald-500' },
                    { l: 'POS / Banka', val: reportAnalysis.posEx, r: (reportAnalysis.posEx / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-blue-500' },
                    { l: 'Genel Gider', val: reportAnalysis.totalEx - (reportAnalysis.staffEx + reportAnalysis.malEx + reportAnalysis.posEx), r: ((reportAnalysis.totalEx - (reportAnalysis.staffEx + reportAnalysis.malEx + reportAnalysis.posEx)) / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-slate-300' }
                  ].map((item, i) => (
                    <div key={i} className="group">
                      <div className="flex justify-between text-[7px] font-black uppercase text-slate-500 mb-1.5 italic"><span>{item.l}</span><span>%{item.r.toFixed(0)}</span></div>
                      <div className="w-full h-2.5 bg-slate-50 rounded-full border border-slate-100 overflow-hidden shadow-inner flex items-center"><div className={`h-full ${item.c} transition-all duration-1000 shadow-sm`} style={{width: `${item.r}%`}}></div></div>
                    </div>
                  ))}
                </div>
              </div>
              <div className="bg-slate-900 p-6 rounded-3xl text-white shadow-2xl relative overflow-hidden border border-white/5 flex flex-col justify-between">
                <div>
                   <h3 className="text-[9px] font-black laos-gradient-text uppercase italic mb-6 tracking-widest">Yönetici Notu</h3>
                   <div className="space-y-4 relative z-10">
                      <div className="bg-white/5 p-3 rounded-xl border border-white/5 backdrop-blur-sm">
                        <p className="text-[7px] font-black text-slate-500 uppercase mb-1.5 italic tracking-widest">Verimlilik Analizi</p>
                        <p className="text-[10px] font-bold italic leading-relaxed text-slate-200">Personel giderleri toplam cironun %{((reportAnalysis.staffEx / (reportAnalysis.totalIn || 1)) * 100).toFixed(0)}'si seviyesindedir.</p>
                      </div>
                      <div className="bg-white/5 p-3 rounded-xl border border-white/5 backdrop-blur-sm">
                        <p className="text-[7px] font-black text-slate-500 uppercase mb-1.5 italic tracking-widest">Maliyet Durumu</p>
                        <p className="text-[10px] font-bold italic leading-relaxed text-slate-200">Ürün alım maliyeti toplam ciroya kıyasla %{((reportAnalysis.malEx / (reportAnalysis.totalIn || 1)) * 100).toFixed(0)} seviyesindedir.</p>
                      </div>
                   </div>
                </div>
                <div className="mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
                   <p className="text-[6px] font-black text-slate-500 uppercase tracking-[0.4em] italic">LAOS FINANS TEKNOLOJILERI</p>
                </div>
              </div>
            </div>
          </div>
        )}
      </main>

      {/* SYNC DURUMU */}
      <div className="fixed top-3 right-3 z-[1001] md:top-6 md:right-6">
        <div className="px-3 py-1.5 rounded-full bg-slate-950/80 backdrop-blur-md shadow-2xl border border-white/10 flex items-center gap-2">
          <div className="w-1.5 h-1.5 rounded-full bg-amber-500 shadow-[0_0_8px_#f59e0b] animate-pulse"></div>
          <span className="text-[7px] font-black text-amber-500 uppercase tracking-widest italic font-bold">Laos Connect</span>
        </div>
      </div>
    </div>
  );
}
