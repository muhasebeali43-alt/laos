import React, { useState, useEffect, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getAuth, 
  signInAnonymously, 
  signInWithCustomToken, 
  onAuthStateChanged 
} from 'firebase/auth';
import { 
  getFirestore, 
  doc, 
  setDoc, 
  collection, 
  onSnapshot, 
  updateDoc, 
  deleteDoc,
  addDoc 
} from 'firebase/firestore';
import { 
  TrendingUp, 
  TrendingDown, 
  DollarSign, 
  Coffee, 
  Users, 
  PieChart, 
  Plus, 
  Trash2, 
  Calendar, 
  Receipt, 
  Percent, 
  RefreshCw, 
  Bell, 
  Check, 
  BarChart3, 
  CalendarDays,
  Banknote,
  LayoutDashboard,
  UserPlus,
  ChevronLeft,
  History,
  ArrowRight
} from 'lucide-react';

// Firebase Yapılandırması
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-cafe-app';

const App = () => {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('dashboard');
  const [loading, setLoading] = useState(true);
  const [saveStatus, setSaveStatus] = useState({});
  const [reportRange, setReportRange] = useState('monthly'); 
  const [customStartDate, setCustomStartDate] = useState(new Date().toISOString().split('T')[0]);
  const [customEndDate, setCustomEndDate] = useState(new Date().toISOString().split('T')[0]);
  
  // Personel Detay Takibi
  const [selectedPersonnelId, setSelectedPersonnelId] = useState(null);

  // Uygulama Durumu
  const [settings, setSettings] = useState({
    initialBalance: 0,
    defaultCommission: 3.5
  });
  const [dailyLogs, setDailyLogs] = useState([]);
  const [scheduledPayments, setScheduledPayments] = useState([]);
  const [personnel, setPersonnel] = useState([]);
  const [personnelPayments, setPersonnelPayments] = useState([]);

  // 1. Kimlik Doğrulama
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (error) {
        console.error("Auth error:", error);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (u) => {
      setUser(u);
    });
    return () => unsubscribe();
  }, []);

  // 2. Gerçek Zamanlı Bulut Senkronizasyonu
  useEffect(() => {
    if (!user) return;

    const publicPath = (coll) => collection(db, 'artifacts', appId, 'public', 'data', coll);
    const settingsDoc = doc(db, 'artifacts', appId, 'public', 'data', 'config', 'app_settings');

    const unsubSettings = onSnapshot(settingsDoc, (d) => d.exists() && setSettings(d.data()), (e) => console.error(e));
    const unsubLogs = onSnapshot(publicPath('dailyLogs'), (s) => setDailyLogs(s.docs.map(d => ({id: d.id, ...d.data()}))), (e) => console.error(e));
    const unsubPayments = onSnapshot(publicPath('scheduledPayments'), (s) => setScheduledPayments(s.docs.map(d => ({id: d.id, ...d.data()}))), (e) => console.error(e));
    const unsubPersonnel = onSnapshot(publicPath('personnel'), (s) => setPersonnel(s.docs.map(d => ({id: d.id, ...d.data()}))), (e) => console.error(e));
    const unsubPersonnelPayments = onSnapshot(publicPath('personnelPayments'), (s) => setPersonnelPayments(s.docs.map(d => ({id: d.id, ...d.data()}))), (e) => console.error(e));

    setLoading(false);

    return () => {
      unsubSettings();
      unsubLogs();
      unsubPayments();
      unsubPersonnel();
      unsubPersonnelPayments();
    };
  }, [user]);

  // --- YARDIMCILAR ---
  const formatCurrency = (val) => {
    const number = parseFloat(val) || 0;
    return new Intl.NumberFormat('tr-TR', { 
      style: 'currency', 
      currency: 'TRY',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(number);
  };

  const setFeedback = (id) => {
    setSaveStatus(prev => ({ ...prev, [id]: 'saved' }));
    setTimeout(() => {
      setSaveStatus(prev => {
        const next = { ...prev };
        delete next[id];
        return next;
      });
    }, 2000);
  };

  // --- HESAPLAMALAR ---
  const totals = useMemo(() => {
    return dailyLogs.reduce((acc, log) => {
      const commRate = log.commissionRate !== undefined ? Number(log.commissionRate) : settings.defaultCommission;
      const cardComm = (Number(log.card || 0) * commRate) / 100;
      return {
        loanAmount: acc.loanAmount + Number(log.dailyLoan || 0),
        cash: acc.cash + Number(log.cash || 0),
        cardGross: acc.cardGross + Number(log.card || 0),
        cardNet: acc.cardNet + (Number(log.card || 0) - cardComm),
        commissions: acc.commissions + cardComm,
        transfer: acc.transfer + Number(log.transfer || 0),
        cheque: acc.cheque + Number(log.cheque || 0)
      };
    }, { loanAmount: 0, cash: 0, cardGross: 0, cardNet: 0, commissions: 0, transfer: 0, cheque: 0 });
  }, [dailyLogs, settings.defaultCommission]);

  const totalPaidScheduled = useMemo(() => scheduledPayments.filter(p => p.status === 'paid').reduce((s, p) => s + Number(p.amount), 0), [scheduledPayments]);
  const totalPendingScheduled = useMemo(() => scheduledPayments.filter(p => p.status === 'pending').reduce((s, p) => s + Number(p.amount), 0), [scheduledPayments]);
  
  // Personel Maliyetleri ve Ödemeleri
  const staffStats = useMemo(() => {
    const totalPaymentsMade = personnelPayments.reduce((s, p) => s + Number(p.amount || 0), 0);
    const totalSalaryLiability = personnel.reduce((s, p) => {
      const base = p.type === 'Tam Zamanlı' ? Number(p.fixedSalary || 0) : (Number(p.hourlyRate || 0) * Number(p.hoursWorked || 0));
      return s + base;
    }, 0);
    return { totalPaymentsMade, totalSalaryLiability };
  }, [personnel, personnelPayments]);
  
  const totalOutflow = staffStats.totalPaymentsMade + totalPaidScheduled + totals.commissions;
  const totalLiquidity = Number(settings.initialBalance || 0) + (totals.cash + totals.cardGross + totals.transfer + totals.cheque) + totals.loanAmount - totalOutflow;

  const upcomingPayments = useMemo(() => {
    const today = new Date();
    today.setHours(0,0,0,0);
    return scheduledPayments
      .filter(p => p.status === 'pending' && p.dueDate)
      .map(p => {
        const due = new Date(p.dueDate);
        due.setHours(0,0,0,0);
        const daysLeft = Math.ceil((due - today) / (1000 * 60 * 60 * 24));
        return { ...p, daysLeft };
      })
      .sort((a, b) => a.daysLeft - b.daysLeft);
  }, [scheduledPayments]);

  // --- RAPOR HESAPLAMALARI ---
  const reportData = useMemo(() => {
    const now = new Date();
    const filterData = (item) => {
      const itemDate = new Date(item.date || item.dueDate || item.createdAt.toDate?.() || item.createdAt);
      itemDate.setHours(0, 0, 0, 0);

      if (reportRange === 'daily') return itemDate.toDateString() === now.toDateString();
      if (reportRange === 'monthly') return itemDate.getMonth() === now.getMonth() && itemDate.getFullYear() === now.getFullYear();
      if (reportRange === 'yearly') return itemDate.getFullYear() === now.getFullYear();
      if (reportRange === 'custom') {
        const start = new Date(customStartDate);
        const end = new Date(customEndDate);
        start.setHours(0,0,0,0);
        end.setHours(23,59,59,999);
        return itemDate >= start && itemDate <= end;
      }
      return true;
    };

    const filteredLogs = dailyLogs.filter(filterData);
    const filteredPayments = scheduledPayments.filter(filterData);
    const filteredStaffPayments = personnelPayments.filter(filterData);

    const income = filteredLogs.reduce((acc, log) => {
      const commRate = log.commissionRate !== undefined ? Number(log.commissionRate) : settings.defaultCommission;
      const comm = (Number(log.card || 0) * commRate) / 100;
      return {
        loans: acc.loans + Number(log.dailyLoan || 0),
        cash: acc.cash + Number(log.cash || 0),
        card: acc.card + Number(log.card || 0),
        transfer: acc.transfer + Number(log.transfer || 0),
        cheque: acc.cheque + Number(log.cheque || 0),
        commissions: acc.commissions + comm
      };
    }, { loans: 0, cash: 0, card: 0, transfer: 0, cheque: 0, commissions: 0 });

    const totalIncome = income.cash + income.card + income.transfer + income.cheque;

    const expense = {
      staff: filteredStaffPayments.reduce((s, p) => s + Number(p.amount || 0), 0),
      scheduledPaid: filteredPayments.filter(p => p.status === 'paid').reduce((s, p) => s + Number(p.amount || 0), 0),
      bankComm: income.commissions,
      fixed: 0 // Gerekirse ek outlows eklenebilir
    };

    const totalExpense = expense.staff + expense.scheduledPaid + expense.bankComm;

    return { income, expense, totalIncome, totalExpense };
  }, [dailyLogs, scheduledPayments, personnelPayments, reportRange, customStartDate, customEndDate, settings.defaultCommission]);

  // --- VERİTABANI İŞLEMLERİ ---
  const saveSetting = async (field, value) => {
    if (!user) return;
    const settingsDoc = doc(db, 'artifacts', appId, 'public', 'data', 'config', 'app_settings');
    await setDoc(settingsDoc, { ...settings, [field]: value }, { merge: true });
    setFeedback(field);
  };

  const addLog = async () => {
    if (!user) return;
    const docRef = await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'dailyLogs'), {
      date: new Date().toISOString().split('T')[0],
      dailyLoan: 0,
      cash: 0, card: 0, commissionRate: settings.defaultCommission, transfer: 0, cheque: 0, createdAt: new Date()
    });
    setFeedback(docRef.id);
  };

  const updateLog = async (id, data) => {
    if (!user) return;
    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'dailyLogs', id), data);
    setFeedback(id);
  };

  const addScheduledPayment = async () => {
    if (!user) return;
    const docRef = await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'scheduledPayments'), {
      label: 'Yeni Ödeme', amount: 0, dueDate: '', status: 'pending', method: 'Nakit', loanCovered: 0, createdAt: new Date()
    });
    setFeedback(docRef.id);
  };

  const updateScheduledPayment = async (id, data) => {
    if (!user) return;
    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'scheduledPayments', id), data);
    setFeedback(id);
  };

  const addPersonnel = async () => {
    if (!user) return;
    const docRef = await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'personnel'), {
      name: 'Yeni Personel', type: 'Tam Zamanlı', hourlyRate: 0, hoursWorked: 0, fixedSalary: 0, createdAt: new Date()
    });
    setFeedback(docRef.id);
  };

  const updatePersonnel = async (id, data) => {
    if (!user) return;
    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'personnel', id), data);
    setFeedback(id);
  };

  const addPersonnelPayment = async (personnelId) => {
    if (!user) return;
    const docRef = await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'personnelPayments'), {
      personnelId,
      amount: 0,
      date: new Date().toISOString().split('T')[0],
      createdAt: new Date()
    });
    setFeedback(docRef.id);
  };

  const updatePersonnelPayment = async (id, data) => {
    if (!user) return;
    await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'personnelPayments', id), data);
    setFeedback(id);
  };

  const deleteItem = async (coll, id) => {
    if (!user) return;
    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', coll, id));
  };

  if (loading) return (
    <div className="min-h-screen bg-slate-950 flex flex-col items-center justify-center text-white">
      <RefreshCw className="animate-spin text-amber-500 mb-4" size={48} />
      <p className="text-slate-400 font-medium tracking-widest uppercase text-xs tracking-[0.2em]">Veriler Çekiliyor</p>
    </div>
  );

  return (
    <div className="min-h-screen bg-[#F8FAFC] font-sans text-slate-900 flex flex-col md:flex-row pb-20 md:pb-0">
      
      {/* Mobil Başlık */}
      <div className="md:hidden bg-slate-950 text-white p-4 flex justify-between items-center shadow-lg">
        <div className="flex items-center gap-2">
          <Coffee className="text-amber-500" size={20} />
          <h1 className="font-black tracking-tight text-lg uppercase">Kafe Pro</h1>
        </div>
        <div className="flex items-center gap-2 bg-slate-900 px-3 py-1 rounded-full border border-slate-800">
           <div className={`w-2 h-2 rounded-full ${Object.keys(saveStatus).length > 0 ? 'bg-amber-500 animate-pulse' : 'bg-green-500'}`}></div>
           <span className="text-[10px] font-bold text-slate-300 tracking-tighter uppercase">Bulut Aktif</span>
        </div>
      </div>

      {/* Navigasyon */}
      <nav className="fixed bottom-0 left-0 right-0 md:relative md:w-72 bg-slate-950 text-white p-2 md:p-6 flex md:flex-col shadow-[0_-10px_20px_rgba(0,0,0,0.2)] md:shadow-2xl z-50 border-t border-slate-900 md:border-none">
        <div className="hidden md:flex items-center gap-3 mb-10">
          <div className="bg-amber-500 p-2.5 rounded-xl">
            <Coffee size={24} className="text-white" />
          </div>
          <h2 className="text-xl font-bold tracking-tight uppercase">Kafe Analiz</h2>
        </div>
        
        <div className="flex flex-row md:flex-col justify-around w-full gap-1 md:gap-2">
          {[
            { id: 'dashboard', icon: LayoutDashboard, label: 'Özet' },
            { id: 'daily', icon: Calendar, label: 'Günlük' },
            { id: 'payments', icon: Receipt, label: 'Ödemeler' },
            { id: 'personnel', icon: Users, label: 'Personel' },
            { id: 'reports', icon: BarChart3, label: 'Raporlar' },
          ].map((tab) => (
            <button 
              key={tab.id}
              onClick={() => { setActiveTab(tab.id); setSelectedPersonnelId(null); }}
              className={`flex flex-col md:flex-row items-center gap-1 md:gap-4 p-2 md:p-4 rounded-2xl transition-all flex-1 md:flex-none ${activeTab === tab.id ? 'bg-amber-500 text-white shadow-xl scale-105 md:scale-100' : 'text-slate-500 md:hover:bg-slate-900'}`}
            >
              <tab.icon size={20} /> 
              <span className="text-[10px] md:text-sm font-bold uppercase tracking-tighter md:tracking-normal">{tab.label}</span>
            </button>
          ))}
        </div>

        <div className="hidden md:block mt-auto border-t border-slate-900 pt-8 text-center">
            <p className="text-[10px] text-slate-500 uppercase font-bold mb-1 tracking-widest uppercase">Toplam Likidite</p>
            <p className={`text-2xl font-black ${totalLiquidity >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {formatCurrency(totalLiquidity)}
            </p>
        </div>
      </nav>

      {/* Ana İçerik */}
      <main className="flex-1 p-4 md:p-10 overflow-y-auto max-w-full overflow-x-hidden pb-24 md:pb-10">
        
        {activeTab === 'dashboard' && (
          <div className="max-w-4xl mx-auto space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
            <header className="flex flex-col gap-4">
              <div className="flex justify-between items-center">
                <h1 className="text-2xl md:text-4xl font-black text-slate-900 tracking-tight">İşletme Özeti</h1>
                <div className="flex items-center gap-2 text-[10px] font-bold text-slate-400 bg-white px-3 py-1 rounded-full border border-slate-100 uppercase tracking-tighter">
                  {Object.keys(saveStatus).length > 0 ? (
                    <><RefreshCw size={10} className="animate-spin text-amber-500" /> Kaydediliyor...</>
                  ) : (
                    <><Check size={10} className="text-green-500" /> Senkronize</>
                  )}
                </div>
              </div>

              {/* Kasa Başlangıç */}
              <div className="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100 relative group">
                <div className="flex justify-between items-center mb-1">
                  <div className="flex items-center gap-2">
                    <Banknote className="text-amber-500" size={18} />
                    <span className="text-xs font-black text-slate-400 uppercase tracking-widest">Sistem Kasa Başlangıç Bakiyesi</span>
                  </div>
                  {saveStatus['initialBalance'] && <Check size={14} className="text-green-500 animate-in zoom-in" />}
                </div>
                <div className="flex items-baseline gap-2">
                   <span className="text-2xl font-black text-slate-400">₺</span>
                   <input 
                    step="0.01" 
                    type="number" 
                    value={settings.initialBalance} 
                    onChange={(e) => saveSetting('initialBalance', e.target.value)} 
                    className="text-3xl font-black w-full bg-transparent border-none p-0 focus:ring-0 text-slate-900" 
                    placeholder="0,00"
                  />
                </div>
              </div>
            </header>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="bg-slate-900 p-6 rounded-[2.5rem] shadow-2xl text-white relative overflow-hidden group">
                <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform">
                  <PieChart size={120} />
                </div>
                <p className="text-[10px] font-bold text-slate-500 uppercase mb-1 tracking-widest uppercase">Net Likidite Durumu</p>
                <p className="text-4xl font-black text-amber-400 mb-6">{formatCurrency(totalLiquidity)}</p>
                <div className="space-y-3">
                  <div className="flex justify-between items-center text-xs border-t border-slate-800 pt-3">
                    <span className="text-slate-400">Birikmiş Kredi/Borç</span>
                    <span className="font-bold text-blue-400">{formatCurrency(totals.loanAmount)}</span>
                  </div>
                  <div className="flex justify-between items-center text-xs">
                    <span className="text-slate-400">Toplam Personel Ödemesi</span>
                    <span className="font-bold text-amber-400">{formatCurrency(staffStats.totalPaymentsMade)}</span>
                  </div>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div className="bg-white p-5 rounded-[2rem] shadow-sm border border-slate-100">
                  <TrendingUp className="text-green-500 mb-2" size={20} />
                  <p className="text-[9px] font-bold text-slate-400 uppercase">Toplam Ciro</p>
                  <p className="text-lg font-black text-slate-800">{formatCurrency(totals.cash + totals.cardGross)}</p>
                </div>
                <div className="bg-white p-5 rounded-[2rem] shadow-sm border border-slate-100">
                  <TrendingDown className="text-red-500 mb-2" size={20} />
                  <p className="text-[9px] font-bold text-slate-400 uppercase">Toplam Gider</p>
                  <p className="text-lg font-black text-slate-800">{formatCurrency(totalOutflow)}</p>
                </div>
                <div className="bg-white p-5 rounded-[2rem] shadow-sm border border-slate-100">
                  <Users className="text-amber-500 mb-2" size={20} />
                  <p className="text-[9px] font-bold text-slate-400 uppercase">Toplam Maaş Yükü</p>
                  <p className="text-lg font-black text-slate-800">{formatCurrency(staffStats.totalSalaryLiability)}</p>
                </div>
                
                <div className="bg-white p-5 rounded-[2rem] shadow-sm border border-slate-100 group/comm relative">
                  <Percent className="text-blue-500 mb-2" size={20} />
                  <p className="text-[9px] font-bold text-slate-400 uppercase">Banka Komisyonu</p>
                  <p className="text-lg font-black text-slate-800">{formatCurrency(totals.commissions)}</p>
                </div>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'daily' && (
          <div className="max-w-2xl mx-auto space-y-4 pb-10">
            <div className="flex justify-between items-center px-2 mb-6">
              <h2 className="text-2xl font-black text-slate-900">Günlük İşlemler</h2>
              <button onClick={addLog} className="bg-slate-900 text-white p-4 rounded-[2rem] shadow-xl active:scale-90 transition-all"><Plus size={24} /></button>
            </div>
            
            <div className="space-y-6">
              {dailyLogs.sort((a,b) => new Date(b.date) - new Date(a.date)).map(log => (
                <div key={log.id} className="bg-white rounded-[2.5rem] p-6 shadow-sm border border-slate-100 space-y-6 relative overflow-hidden">
                  <div className="flex justify-between items-center border-b border-slate-50 pb-4">
                    <div className="flex items-center gap-2 text-slate-800">
                      <Calendar size={16} className="text-slate-400" />
                      <input type="date" value={log.date} onChange={(e) => updateLog(log.id, {date: e.target.value})} className="font-black text-sm border-none p-0 bg-transparent focus:ring-0" />
                    </div>
                    <button onClick={() => deleteItem('dailyLogs', log.id)} className="text-red-200 hover:text-red-500 transition-colors"><Trash2 size={18} /></button>
                  </div>

                  <div className="grid grid-cols-2 gap-5">
                    <div className="space-y-1">
                      <label className="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">Nakit Ciro</label>
                      <input step="0.01" type="number" value={log.cash} onChange={(e) => updateLog(log.id, {cash: e.target.value})} className="w-full bg-slate-50 p-4 rounded-2xl font-black text-lg border-none" />
                    </div>
                    <div className="space-y-1">
                      <label className="text-[9px] font-black text-blue-400 uppercase tracking-widest ml-1">POS Ciro</label>
                      <input step="0.01" type="number" value={log.card} onChange={(e) => updateLog(log.id, {card: e.target.value})} className="w-full bg-blue-50/50 p-4 rounded-2xl font-black text-lg text-blue-700 border-none" />
                    </div>
                  </div>

                  <div className="bg-blue-50 p-6 rounded-3xl border border-blue-100 space-y-2">
                    <div className="flex items-center gap-2">
                      <DollarSign size={16} className="text-blue-600" />
                      <label className="text-[11px] font-black text-blue-700 uppercase tracking-widest">Kredi / Borç</label>
                    </div>
                    <input step="0.01" type="number" value={log.dailyLoan || 0} onChange={(e) => updateLog(log.id, {dailyLoan: e.target.value})} className="w-full bg-white/60 p-4 rounded-2xl font-black text-2xl border-none focus:ring-2 focus:ring-blue-200" placeholder="0,00" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {activeTab === 'personnel' && (
          <div className="max-w-4xl mx-auto animate-in fade-in duration-500">
            {selectedPersonnelId ? (
              // PERSONEL DETAY GÖRÜNÜMÜ
              <div className="space-y-6">
                <button onClick={() => setSelectedPersonnelId(null)} className="flex items-center gap-2 text-slate-500 hover:text-slate-900 transition-colors font-bold uppercase text-[10px]">
                  <ChevronLeft size={16} /> Personel Listesine Dön
                </button>

                {personnel.filter(p => p.id === selectedPersonnelId).map(p => {
                  const myPayments = personnelPayments.filter(pay => pay.personnelId === p.id).sort((a,b) => new Date(b.date) - new Date(a.date));
                  const totalPaid = myPayments.reduce((s, pay) => s + Number(pay.amount || 0), 0);
                  const totalSalary = p.type === 'Tam Zamanlı' ? Number(p.fixedSalary || 0) : (Number(p.hourlyRate || 0) * Number(p.hoursWorked || 0));
                  
                  return (
                    <div key={p.id} className="space-y-6">
                      <div className="bg-white rounded-[2.5rem] p-8 shadow-sm border border-slate-100">
                        <div className="flex justify-between items-start mb-8">
                          <div>
                            <input value={p.name} onChange={(e) => updatePersonnel(p.id, {name: e.target.value})} className="text-3xl font-black text-slate-900 border-none p-0 focus:ring-0 bg-transparent w-full mb-2" />
                            <div className="flex gap-2">
                               <span className={`px-3 py-1 rounded-full text-[9px] font-black uppercase ${p.type === 'Tam Zamanlı' ? 'bg-indigo-100 text-indigo-700' : 'bg-amber-100 text-amber-700'}`}>{p.type}</span>
                            </div>
                          </div>
                          <div className="text-right">
                             <p className="text-[10px] font-black text-slate-400 uppercase tracking-widest">Kalan Hakediş</p>
                             <p className="text-3xl font-black text-green-600">{formatCurrency(totalSalary - totalPaid)}</p>
                          </div>
                        </div>

                        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                           <div className="bg-slate-50 p-4 rounded-3xl border border-slate-100">
                              <p className="text-[9px] font-black text-slate-400 uppercase mb-2">Maaş Ayarı</p>
                              <div className="space-y-3">
                                <div className="flex justify-between items-center">
                                  <span className="text-[10px] font-bold text-slate-500">{p.type === 'Part-Time' ? 'Saat Ücreti' : 'Aylık Maaş'}</span>
                                  <input type="number" value={p.type === 'Part-Time' ? p.hourlyRate : p.fixedSalary} onChange={(e) => updatePersonnel(p.id, p.type === 'Part-Time' ? {hourlyRate: e.target.value} : {fixedSalary: e.target.value})} className="w-20 text-right font-black text-xs border-none bg-white rounded px-2 py-1" />
                                </div>
                                {p.type === 'Part-Time' && (
                                  <div className="flex justify-between items-center">
                                    <span className="text-[10px] font-bold text-slate-500">Çalışılan Saat</span>
                                    <input type="number" value={p.hoursWorked} onChange={(e) => updatePersonnel(p.id, {hoursWorked: e.target.value})} className="w-20 text-right font-black text-xs border-none bg-white rounded px-2 py-1" />
                                  </div>
                                )}
                              </div>
                           </div>
                           <div className="bg-blue-50 p-4 rounded-3xl border border-blue-100 flex flex-col justify-center">
                              <p className="text-[9px] font-black text-blue-400 uppercase mb-1 text-center">Toplam Alacak</p>
                              <p className="text-xl font-black text-blue-700 text-center">{formatCurrency(totalSalary)}</p>
                           </div>
                           <div className="bg-amber-50 p-4 rounded-3xl border border-amber-100 flex flex-col justify-center">
                              <p className="text-[9px] font-black text-amber-500 uppercase mb-1 text-center">Toplam Ödenen</p>
                              <p className="text-xl font-black text-amber-700 text-center">{formatCurrency(totalPaid)}</p>
                           </div>
                        </div>
                      </div>

                      {/* Ödeme Geçmişi */}
                      <div className="bg-white rounded-[2.5rem] p-8 shadow-sm border border-slate-100">
                        <div className="flex justify-between items-center mb-6">
                           <h3 className="text-lg font-black text-slate-900 flex items-center gap-2">
                             <History size={18} className="text-amber-500" /> Ödeme Kayıtları
                           </h3>
                           <button onClick={() => addPersonnelPayment(p.id)} className="bg-slate-900 text-white px-4 py-2 rounded-2xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2 active:scale-95 transition-all">
                             <Plus size={14} /> Yeni Ödeme Ekle
                           </button>
                        </div>
                        
                        <div className="space-y-3">
                          {myPayments.length > 0 ? (
                            myPayments.map(pay => (
                              <div key={pay.id} className="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100">
                                <div className="flex items-center gap-4">
                                  <input type="date" value={pay.date} onChange={(e) => updatePersonnelPayment(pay.id, {date: e.target.value})} className="bg-transparent border-none p-0 text-xs font-black text-slate-500 focus:ring-0" />
                                  <div className="h-4 w-[1px] bg-slate-200"></div>
                                  <div className="flex items-center gap-1">
                                    <span className="text-xs font-bold text-slate-400">₺</span>
                                    <input type="number" step="0.01" value={pay.amount} onChange={(e) => updatePersonnelPayment(pay.id, {amount: e.target.value})} className="bg-transparent border-none p-0 text-sm font-black text-slate-900 focus:ring-0 w-24" />
                                  </div>
                                </div>
                                <button onClick={() => deleteItem('personnelPayments', pay.id)} className="text-red-200 hover:text-red-500 transition-colors"><Trash2 size={16} /></button>
                              </div>
                            ))
                          ) : (
                            <p className="text-center py-10 text-slate-400 text-xs font-bold uppercase italic">Henüz bir ödeme kaydı bulunmuyor.</p>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            ) : (
              // PERSONEL LİSTESİ
              <div className="space-y-6">
                <div className="flex justify-between items-center">
                  <h2 className="text-3xl font-black text-slate-900 tracking-tight">Personel Yönetimi</h2>
                  <button onClick={addPersonnel} className="bg-slate-900 text-white p-4 rounded-3xl shadow-xl active:scale-95 transition-all"><UserPlus size={24} /></button>
                </div>
                
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {personnel.map(p => {
                    const myPayments = personnelPayments.filter(pay => pay.personnelId === p.id);
                    const totalPaid = myPayments.reduce((s, pay) => s + Number(pay.amount || 0), 0);
                    const totalSalary = p.type === 'Tam Zamanlı' ? Number(p.fixedSalary || 0) : (Number(p.hourlyRate || 0) * Number(p.hoursWorked || 0));
                    
                    return (
                      <div key={p.id} onClick={() => setSelectedPersonnelId(p.id)} className="bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100 group hover:border-amber-400 transition-all cursor-pointer relative overflow-hidden">
                        <div className="flex justify-between items-start mb-4">
                          <div>
                            <p className="text-xl font-black text-slate-900 group-hover:text-amber-600 transition-colors">{p.name}</p>
                            <span className="text-[9px] font-black text-slate-400 uppercase tracking-widest">{p.type}</span>
                          </div>
                          <div className="bg-slate-50 p-2 rounded-xl group-hover:bg-amber-50 transition-colors">
                            <ArrowRight size={18} className="text-slate-300 group-hover:text-amber-500" />
                          </div>
                        </div>

                        <div className="flex justify-between items-end border-t border-slate-50 pt-4">
                           <div className="space-y-1">
                             <p className="text-[9px] font-black text-slate-400 uppercase">Ödenen</p>
                             <p className="text-sm font-black text-slate-600">{formatCurrency(totalPaid)}</p>
                           </div>
                           <div className="text-right space-y-1">
                             <p className="text-[9px] font-black text-green-400 uppercase">Kalan Hakediş</p>
                             <p className="text-lg font-black text-green-600">{formatCurrency(totalSalary - totalPaid)}</p>
                           </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        )}

        {/* Ödemeler & Raporlar sekmeleri senkronize çalışmaya devam eder */}
        {activeTab === 'payments' && (
          <div className="max-w-2xl mx-auto space-y-4 pb-10">
            <div className="flex justify-between items-center px-2 mb-6">
              <h2 className="text-2xl font-black text-slate-900">Ödemeler & Borçlar</h2>
              <button onClick={addScheduledPayment} className="bg-slate-900 text-white p-4 rounded-[2rem] shadow-xl active:scale-90 transition-all"><Plus size={24} /></button>
            </div>
            <div className="space-y-4">
              {scheduledPayments.map(p => (
                <div key={p.id} className={`bg-white rounded-[2.5rem] p-6 shadow-sm border transition-all relative ${p.status === 'paid' ? 'border-green-100 opacity-60' : 'border-slate-100 shadow-lg shadow-slate-200/50'}`}>
                  <div className="flex justify-between items-start mb-4">
                    <div className="flex-1">
                      <input value={p.label} onChange={(e) => updateScheduledPayment(p.id, {label: e.target.value})} className="font-black text-lg border-none p-0 bg-transparent focus:ring-0 text-slate-800 w-full" />
                      <div className="flex gap-2 mt-2">
                        <select value={p.method} onChange={(e) => updateScheduledPayment(p.id, {method: e.target.value})} className="text-[10px] font-bold bg-slate-100 px-2 py-1 rounded-full border-none uppercase">
                          <option value="Nakit">Nakit</option><option value="Havale">Havale</option><option value="Kredi Kartı">Kart</option><option value="Çek">Çek</option>
                        </select>
                        <input type="date" value={p.dueDate} onChange={(e) => updateScheduledPayment(p.id, {dueDate: e.target.value})} className="text-[10px] font-bold bg-slate-100 px-2 py-1 rounded-full border-none" />
                      </div>
                    </div>
                    <button onClick={() => deleteItem('scheduledPayments', p.id)} className="text-red-200 hover:text-red-500 transition-colors"><Trash2 size={16} /></button>
                  </div>
                  <div className="flex justify-between items-center">
                    <div className="space-y-1">
                      <p className="text-[9px] font-black text-slate-400 uppercase tracking-widest ml-1">Tutar</p>
                      <input step="0.01" type="number" value={p.amount} onChange={(e) => updateScheduledPayment(p.id, {amount: e.target.value})} className="bg-slate-50 p-3 rounded-2xl font-black text-lg border-none focus:ring-0 w-32" />
                    </div>
                    <button onClick={() => updateScheduledPayment(p.id, {status: p.status === 'paid' ? 'pending' : 'paid'})} className={`px-8 py-4 rounded-[2rem] font-black text-xs uppercase transition-all shadow-lg ${p.status === 'paid' ? 'bg-green-500 text-white' : 'bg-slate-900 text-white'}`}>
                      {p.status === 'paid' ? 'Ödendi' : 'Öde'}
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {activeTab === 'reports' && (
          <div className="max-w-4xl mx-auto space-y-6 animate-in fade-in zoom-in duration-500">
            <header className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
              <div>
                <h1 className="text-3xl font-black text-slate-900 tracking-tight">Finansal Analiz</h1>
                <p className="text-slate-500 text-sm font-medium">Gelir dağılımı ve nakit akışı raporu.</p>
              </div>
              <div className="flex bg-white p-1 rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
                {['daily', 'monthly', 'yearly', 'custom'].map(range => (
                  <button key={range} onClick={() => setReportRange(range)} className={`px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all whitespace-nowrap ${reportRange === range ? 'bg-slate-900 text-white shadow-lg' : 'text-slate-400 hover:text-slate-600'}`}>
                    {range === 'daily' ? 'Günlük' : range === 'monthly' ? 'Aylık' : range === 'yearly' ? 'Yıllık' : 'Özel'}
                  </button>
                ))}
              </div>
            </header>

            <div className="bg-white rounded-[2.5rem] p-8 shadow-sm border border-slate-100">
              <h3 className="text-xl font-black text-slate-800 mb-6 flex items-center gap-2"><TrendingUp size={20} className="text-green-500" /> Gelir Kaynakları</h3>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <div className="space-y-5">
                  {[
                    { label: 'Nakit Satış', value: reportData.income.cash, color: 'bg-green-500' },
                    { label: 'POS Satış', value: reportData.income.card, color: 'bg-blue-500' },
                    { label: 'Borç / Kredi Girişi', value: reportData.income.loans, color: 'bg-indigo-500' }
                  ].map(item => {
                    const totalRef = reportData.totalIncome + reportData.income.loans;
                    const percentage = totalRef > 0 ? (item.value / totalRef) * 100 : 0;
                    return (
                      <div key={item.label} className="space-y-1">
                        <div className="flex justify-between items-center text-xs font-bold uppercase">
                          <span className="text-slate-500">{item.label}</span>
                          <span className="text-slate-900">{formatCurrency(item.value)} (%{percentage.toFixed(1)})</span>
                        </div>
                        <div className="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
                          <div className={`h-full ${item.color} rounded-full transition-all duration-1000`} style={{ width: `${percentage}%` }}></div>
                        </div>
                      </div>
                    );
                  })}
                </div>
                <div className="bg-slate-50 p-6 rounded-[2rem] border border-slate-100 text-center">
                   <p className="text-[10px] font-black text-slate-400 uppercase mb-1">Dönem Brüt Giriş</p>
                   <p className="text-3xl font-black text-slate-900">{formatCurrency(reportData.totalIncome + reportData.income.loans)}</p>
                </div>
              </div>
            </div>

            <div className="bg-slate-900 rounded-[2.5rem] p-10 text-white shadow-2xl relative overflow-hidden">
               <div className="relative z-10 flex flex-col md:flex-row justify-between items-center gap-8">
                  <div className="text-center md:text-left">
                    <h3 className="text-amber-400 font-black uppercase tracking-[0.2em] text-xs mb-2">Dönem Karı</h3>
                    <p className="text-5xl font-black">{formatCurrency(reportData.totalIncome - reportData.totalExpense)}</p>
                  </div>
                  <div className="bg-white/10 p-6 rounded-[2rem] backdrop-blur-md border border-white/10 text-center min-w-[160px]">
                    <p className="text-[10px] font-bold text-slate-300 uppercase mb-2">Kar Marjı</p>
                    <p className="text-3xl font-black text-amber-500">%{(((reportData.totalIncome - reportData.totalExpense) / reportData.totalIncome) * 100 || 0).toFixed(1)}</p>
                  </div>
               </div>
            </div>
          </div>
        )}

      </main>

      {/* Senkronizasyon Göstergesi */}
      <div className="fixed top-4 right-4 md:hidden z-[60]">
        <div className={`w-2.5 h-2.5 rounded-full shadow-[0_0_15px] transition-all duration-500 ${Object.keys(saveStatus).length > 0 ? 'bg-amber-500 shadow-amber-500/80 animate-pulse scale-125' : 'bg-green-500 shadow-green-500/80 scale-100'}`}></div>
      </div>
      
    </div>
  );
};

export default App;
