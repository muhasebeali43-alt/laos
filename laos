                                                                        const newIngs = [...(prod.ingredients || []), { id: '', amount: 0 }];
                                                                        pRef('products').doc(prod.id).update({ ingredients: newIngs });
                                                                    }} className="w-full py-6 border-2 border-dashed border-slate-200 rounded-[2rem] text-[10px] font-black uppercase text-slate-400 hover:border-amber-400 hover:text-amber-500 transition-all italic bg-slate-50/50 shadow-inner">➕ YENİ SATIR EKLE</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    );
                                                })}
                                            </div>
                                        )}
                                    </div>
                                )}
                            </div>
                        )}

                        {/* BORÇLAR & ÖDEMELER */}
                        {activeTab === 'payments' && (
                            <div className="max-w-2xl mx-auto space-y-6 animate-up">
                                <div className="bg-slate-950 p-6 rounded-[2.5rem] border-b-8 border-amber-500 flex justify-between items-center shadow-2xl">
                                    <h2 className="text-white font-black text-lg md:text-3xl uppercase italic tracking-tighter laos-gradient-text">ÖDEME PLANI</h2>
                                    <button onClick={() => pRef('scheduledPayments').add({ label: 'Yeni Gider', amount: 0, status: 'pending', method: 'nakit', date: new Date().toISOString().split('T')[0] })} className="bg-amber-500 text-slate-950 px-8 py-3 rounded-2xl font-black text-[10px] uppercase italic shadow-lg active:scale-95 transition-all">EKLE</button>
                                </div>
                                {scheduledPayments.sort((a,b) => new Date(b.date) - new Date(a.date)).map(p => (
                                    <div key={p.id} className={`bg-white rounded-[2.5rem] p-8 flex flex-col md:flex-row justify-between items-center gap-6 transition-all ${p.status === 'paid' ? 'opacity-30 grayscale' : 'shadow-sm border-l-[10px] border-red-500 hover:shadow-xl'}`}>
                                        <div className="flex-1 w-full space-y-4">
                                            <div className="flex flex-wrap items-center gap-4">
                                                <div className="bg-slate-50 p-2 rounded-xl border border-slate-100 shadow-inner"><DateInput value={p.date} onChange={(d) => pRef('scheduledPayments').doc(p.id).update({ date: d })} className="text-red-500 font-black" /></div>
                                                <MethodSelector value={p.method} onChange={(m) => pRef('scheduledPayments').doc(p.id).update({ method: m })} className="w-32 md:w-40" />
                                            </div>
                                            <input value={p.label} onChange={(e) => pRef('scheduledPayments').doc(p.id).update({ label: e.target.value })} className="font-black text-sm md:text-2xl w-full uppercase border-none p-0 focus:ring-0 italic text-slate-800 outline-none" placeholder="Gider Adı" />
                                            <div className="flex items-center gap-2 font-black text-lg md:text-4xl text-slate-950 italic tracking-tighter"><span className="text-xs md:text-xl text-slate-300 font-black">₺</span><MoneyInput value={p.amount} onChange={(v) => pRef('scheduledPayments').doc(p.id).update({ amount: v })} className="bg-transparent w-full border-none p-0 focus:ring-0" /></div>
                                        </div>
                                        <div className="flex gap-4 w-full md:w-auto border-t md:border-none pt-6 md:pt-0">
                                            <button onClick={() => pRef('scheduledPayments').doc(p.id).update({ status: p.status === 'paid' ? 'pending' : 'paid' })} className={`flex-1 px-8 py-4 rounded-2xl font-black text-[10px] uppercase transition-all shadow-xl italic tracking-widest ${p.status === 'paid' ? 'bg-green-500 text-white shadow-green-200' : 'bg-slate-950 text-white active:scale-95'}`}>{p.status === 'paid' ? 'ÖDENDİ' : 'ÖDEMEYİ YAP'}</button>
                                            <button onClick={() => setShowDeleteModal({show:true, col:'scheduledPayments', id:p.id})} className="text-red-400 p-3 bg-red-50 rounded-2xl hover:bg-red-500 hover:text-white transition-all shadow-sm">SİL</button>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        )}

                        {/* ANALİZ RAPORU */}
                        {activeTab === 'reports' && (
                            <div className="max-w-6xl mx-auto space-y-10 animate-up pb-24">
                                <header className="flex flex-col md:flex-row justify-between items-center gap-6">
                                    <div className="flex items-center gap-4"><div className="w-2 h-10 bg-amber-500 rounded-full shadow-lg shadow-amber-500/30"></div><h2 className="text-2xl md:text-4xl font-black text-slate-900 tracking-tighter uppercase italic">STRATEJİK ANALİZ</h2></div>
                                    <div className="flex bg-slate-950 p-2 rounded-[2rem] border border-slate-800 shadow-2xl overflow-x-auto no-scrollbar max-w-full">
                                        {['daily', 'monthly', 'custom'].map(r => (
                                            <button key={r} onClick={() => setReportRange(r)} className={`px-8 py-3.5 md:px-12 md:py-4 rounded-full text-[9px] md:text-[11px] font-black uppercase tracking-[0.2em] transition-all italic whitespace-nowrap ${reportRange === r ? 'bg-amber-500 text-slate-950 shadow-xl scale-105' : 'text-slate-500 hover:text-slate-200'}`}>
                                                {r === 'daily' ? 'BUGÜN' : r === 'monthly' ? 'BU AY' : 'ÖZEL ARALIK'}
                                            </button>
                                        ))}
                                    </div>
                                </header>

                                {reportRange === 'custom' && (
                                    <div className="bg-white rounded-[3rem] p-8 md:p-12 flex gap-8 md:gap-16 items-center justify-center border-amber-100 shadow-sm animate-up">
                                        <div className="flex flex-col"><label className="text-[9px] font-black uppercase text-slate-400 mb-3 ml-2 italic tracking-widest">BAŞLANGIÇ</label><div className="bg-slate-50 p-4 rounded-2xl border border-slate-100 shadow-inner"><DateInput value={customStartDate} onChange={setCustomStartDate} /></div></div>
                                        <div className="flex flex-col"><label className="text-[9px] font-black uppercase text-slate-400 mb-3 ml-2 italic tracking-widest">BİTİŞ</label><div className="bg-slate-50 p-4 rounded-2xl border border-slate-100 shadow-inner"><DateInput value={customEndDate} onChange={setCustomEndDate} /></div></div>
                                    </div>
                                )}

                                <div className="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
                                    <div className="bg-white p-8 rounded-[2.5rem] border-l-[10px] border-emerald-500 shadow-sm flex flex-col justify-between group hover:shadow-2xl transition-all">
                                        <p className="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-3 italic">TOPLAM HASILAT</p>
                                        <p className="text-sm md:text-3xl font-black text-slate-900 tracking-tighter italic break-words">{formatCurrency(reportAnalysis.totalIn)}</p>
                                    </div>
                                    <div className="bg-white p-8 rounded-[2.5rem] border-l-[10px] border-red-500 shadow-sm flex flex-col justify-between group hover:shadow-2xl transition-all">
                                        <p className="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-3 italic">TOPLAM GİDER</p>
                                        <p className="text-sm md:text-3xl font-black text-red-600 tracking-tighter italic break-words">{formatCurrency(reportAnalysis.totalEx)}</p>
                                    </div>
                                    <div className="bg-slate-950 p-8 rounded-[2.5rem] text-white shadow-2xl flex flex-col justify-center border-b-8 border-amber-500">
                                        <p className="text-[9px] font-black text-slate-500 uppercase tracking-widest mb-3 italic">DÖNEMSEL NET KÂR</p>
                                        <p className={`text-sm md:text-3xl font-black tracking-tighter italic break-words ${reportAnalysis.profit >= 0 ? 'text-amber-500' : 'text-red-400'}`}>{formatCurrency(reportAnalysis.profit)}</p>
                                    </div>
                                    <div className="bg-white p-8 rounded-[2.5rem] border-l-[10px] border-blue-500 shadow-sm flex flex-col justify-center">
                                        <p className="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-3 italic">KÂR MARJI (%)</p>
                                        <p className="text-sm md:text-3xl font-black text-blue-600 tracking-tighter italic">%{reportAnalysis.margin.toFixed(1)}</p>
                                    </div>
                                </div>

                                <div className="grid grid-cols-1 lg:grid-cols-2 gap-10">
                                    <div className="bg-white rounded-[3rem] p-10 md:p-14 shadow-sm space-y-10">
                                        <h3 className="text-xs md:text-2xl font-black text-slate-800 uppercase italic tracking-[0.2em] border-b border-slate-50 pb-8">GİDER DAĞILIM ANALİZİ</h3>
                                        <div className="space-y-10">
                                            {[
                                                { l: 'Maaş Gideri', val: reportAnalysis.staffEx, r: (reportAnalysis.staffEx / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-amber-500' },
                                                { l: 'Mal / Stok Alımı', val: reportAnalysis.malEx, r: (reportAnalysis.malEx / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-emerald-500' },
                                                { l: 'POS / Banka', val: reportAnalysis.posEx, r: (reportAnalysis.posEx / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-blue-500' },
                                                { l: 'Diğer Genel Giderler', val: reportAnalysis.totalEx - (reportAnalysis.staffEx + reportAnalysis.malEx + reportAnalysis.posEx), r: ((reportAnalysis.totalEx - (reportAnalysis.staffEx + reportAnalysis.malEx + reportAnalysis.posEx)) / (reportAnalysis.totalEx || 1)) * 100, c: 'bg-slate-300' }
                                            ].map((item, i) => (
                                                <div key={i} className="group">
                                                    <div className="flex justify-between text-[10px] font-black uppercase text-slate-500 mb-4 italic tracking-tighter"><span>{String(item.l)}</span><span>%{item.r.toFixed(0)}</span></div>
                                                    <div className="w-full h-4 bg-slate-50 rounded-full border border-slate-100 overflow-hidden shadow-inner flex items-center"><div className={`h-full ${item.c} transition-all duration-1000 shadow-xl`} style={{width: `${item.r}%`}}></div></div>
                                                    <p className="text-right text-[10px] font-black text-slate-800 mt-3 italic tracking-tighter">{formatCurrency(item.val)}</p>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                    <div className="bg-slate-900 p-10 md:p-14 rounded-[3rem] text-white shadow-2xl relative overflow-hidden flex flex-col justify-between border border-white/5">
                                        <div>
                                           <h3 className="text-xs md:text-2xl font-black text-amber-500 uppercase italic mb-12 tracking-[0.2em] laos-gradient-text">STRATEJİK YÖNETİCİ NOTLARI</h3>
                                           <div className="space-y-8 relative z-10">
                                              <div className="bg-white/5 p-8 rounded-[2rem] border border-white/5 backdrop-blur-xl">
                                                <p className="text-[10px] font-black text-slate-500 uppercase mb-4 tracking-widest italic">İŞGÜCÜ VERİMLİLİĞİ</p>
                                                <p className="text-xs md:text-lg font-bold italic leading-relaxed text-slate-200 tracking-tight">Personel giderleri toplam cironun %{((reportAnalysis.staffEx / (reportAnalysis.totalIn || 1)) * 100).toFixed(1)}'ini oluşturuyor.</p>
                                              </div>
                                              <div className="bg-white/5 p-8 rounded-[2rem] border border-white/5 backdrop-blur-xl">
                                                <p className="text-[10px] font-black text-slate-500 uppercase mb-4 tracking-widest italic">MALİYET KONTROLÜ</p>
                                                <p className="text-xs md:text-lg font-bold italic leading-relaxed text-slate-200 tracking-tight">Ürün alım maliyeti toplam ciroya kıyasla %{((reportAnalysis.malEx / (reportAnalysis.totalIn || 1)) * 100).toFixed(1)} seviyesindedir.</p>
                                              </div>
                                           </div>
                                        </div>
                                        <div className="mt-14 pt-10 border-t border-white/5 flex items-center justify-between">
                                           <p className="text-[9px] font-black text-slate-500 uppercase tracking-[0.6em] italic">LAOS FINANS ANALİZ SİSTEMLERİ</p>
                                           <span className="text-amber-500 text-xl animate-pulse italic font-black">⚡ L</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        )}
                    </main>

                    {/* SYNC DURUMU */}
                    <div className="fixed top-4 right-4 z-[1001] md:top-8 md:right-8">
                        <div className="px-5 py-2.5 rounded-full bg-slate-950/95 backdrop-blur-2xl shadow-2xl border border-white/10 flex items-center gap-3">
                            <div className="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-[0_0_15px_#f59e0b] animate-pulse"></div>
                            <span className="text-[9px] font-black text-amber-500 uppercase tracking-[0.3em] italic font-bold">LAOS CONNECTED</span>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
